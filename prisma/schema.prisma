generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IncomeType {
  fixed_salary
  hourly
  occasional
}

model User {
  id           String   @id @default(uuid())
  workosUserId String   @unique @map("workos_user_id")
  homeCurrency String   @map("home_currency")
  createdAt    DateTime @default(now()) @map("created_at")

  categories         ExpenseCategory[]
  allocationVersions AllocationVersion[]
  incomeEntries      IncomeEntry[]
  expenses           Expense[]
  exchangeRates      ExchangeRate[]

  @@map("users")
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  isSavings Boolean  @default(false) @map("is_savings")
  isMixed   Boolean  @default(false) @map("is_mixed")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user              User              @relation(fields: [userId], references: [id])
  allocationEntries AllocationEntry[]
  expenses          Expense[]

  @@map("expense_categories")
}

model AllocationVersion {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id])
  entries AllocationEntry[]

  @@map("allocation_versions")
}

model AllocationEntry {
  id         String  @id @default(uuid())
  versionId  String  @map("version_id")
  categoryId String  @map("category_id")
  percentage Decimal @db.Decimal(5, 2)

  version  AllocationVersion @relation(fields: [versionId], references: [id])
  category ExpenseCategory   @relation(fields: [categoryId], references: [id])

  @@map("allocation_entries")
}

model IncomeEntry {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  type         IncomeType
  month        DateTime?  @db.Date @map("month")
  date         DateTime?  @db.Date
  amount       Decimal    @db.Decimal(14, 2)
  hourlyRate   Decimal?   @db.Decimal(14, 2) @map("hourly_rate")
  hoursWorked  Decimal?   @db.Decimal(8, 2) @map("hours_worked")
  currency     String
  description  String?
  occasionType String?    @map("occasion_type")
  isRecurring  Boolean    @default(false) @map("is_recurring")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("income_entries")
}

model Expense {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  categoryId  String   @map("category_id")
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  month        DateTime @db.Date
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("exchange_rates")
}
